{
  "name": "liveraiz_viewer",
  "version": "1.0.0",
  "description": "LiverAiz 3D Viewer - Desktop Application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev:web": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"npm:electron:dev:web\" \"npm:electron:dev:app\"",
    "electron:dev:app": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "npm run build",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "server": "node server/server.js",
    "dev:server": "nodemon server/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "lucide": "^0.292.0",
    "node-fetch": "^2.7.0",
    "pretendard": "^1.3.9",
    "stats.js": "^0.17.0",
    "three": "^0.158.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "terser": "^5.43.1",
    "vite": "^6.4.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.liveraiz.viewer",
    "productName": "LiverAiz3D Viewer",
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/icon/app.ico",
      "uninstallerIcon": "public/icon/app.ico"
    }
  }
}
