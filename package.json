{
  "name": "liveraiz_viewer",
  "version": "1.0.0",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron:dev:web": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"npm:electron:dev:web\" \"npm:electron:dev:app\"",
    "electron:dev:app": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "electron:build": "npm run build",
    "server": "node server/server.js",
    "dev:server": "nodemon server/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "lucide": "^0.292.0",
    "node-fetch": "^2.7.0",
    "pretendard": "^1.3.9",
    "stats.js": "^0.17.0",
    "three": "^0.158.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.0",
    "terser": "^5.43.1",
    "vite": "^6.4.1",
    "wait-on": "^8.0.5"
  }
